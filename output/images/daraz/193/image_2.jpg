smart, and energy-efficient security with complete area coverage.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn2.gstatic.com/shopping?q=tbn:ANd9GcQPHGu5i93MdqhFMcZw91UWVTbLOlLEyZIYUXJd8j-puruGbbAmRfm_yfIKViLsXwZCQsRAx-vS","width":128,"height":128},{"url":"https://encrypted-tbn2.gstatic.com/shopping?q=tbn:ANd9GcTX3z0WlpcOcYPq7Ewx22s0tUjk5QwaXfYS6ch3Lp03qhx14QhOFNMPH6trZ8H8AdjnRkz3FQYo","width":256,"height":256},{"url":"https://encrypted-tbn2.gstatic.com/shopping?q=tbn:ANd9GcQJo4NFLEXbK8Yt9U_K9jIe4n_i5BlZOk4fbQJCdNeJAMS6gHSWuGFNBtkPjvnSBTARWROiZdGg","width":512,"height":512}],"placeholderColor":4294967295},"price":"د.م.‏ ‏930.51","vendorName":"TP-Link Tapo","trackingParams":"CO0BEJP0ARgEIhMIwYSF0MmJlgMVHvgRCB3dxg4a","buttonText":"تسوّق","buttonCommand":{"clickTrackingParams":"CO0BEJP0ARgEIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CO0BEJP0ARgEIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpIj34_WJ35F9-SF-L56vYjQhRlEPZlFMpkohzqb1THbPJctk5YmSfaTfCknOenCAxxUbrXym_iKMG8_LSsln3xHHkGjwY14R5v4C8L2b5h7gGvgpRK9z3pIEWdYiWIEciG3-eOL-EkjE8vShtsFApCWw0cb2fI9mceKZA_-mfoh3x6MzrrRuTPFEMO7Is-XuhlvJaw9U-9uXNOccHw2Pk-a6WbJzpvEjvvUnHFwGPF8kTZkwsgfQ-OaSXiKv80pu1y-L2EupK31jKAADyHuOpEclARZT6rSCKwdGKwYlDhViHWavI7v7YabMBmLxmyHdeCazZCzN1WrVXCwhUxldQURDwcVn6tSymsf-W7wxXjhacuibfUjonajQiNDCmr12dwomTY3Y53ELNlTrMSgukceC2iaEx6heAcn0fQdjhhOwYHhqiWluBQ72SYFLLrVeUb4Hc-cu9DfYSmasUewCAXMQQWo12eANY2dSiPGGtEGAGQZL2LJ21lrk8B5CB4cI2VZGmY2R90pjmoF3190g85ApbEDwVYLgVNQX1G7vLSyMpAsBCFTs6KXxFkD9F3M6wjaPPKfBkvFI6FsADOhezKodbfv3GuwlqL7bSZMwB9hDcYWk3ryhkt1ePyc5nOBdlmkVoo0MJFu9WPwY80yIqU1C5PLqRv0hYdRFnxjtpVKSwV1vLGAZi57gQgo8AiDaYe1c_FSgyH09ZqluQrgCXWaevLQn8HtUwddOBxzvffbXV9pKk-lv4C-q02x4UkjCPe5cS2zPzhO0Zaq7doHN2dr20aZrjhMzfZOc8YagbjogHOS3u0MrXwYGDApzuuSlFfuDZzYFS4ZkZn21TVouCsVrl7h45H8r8t-BOhrXIQ9FXWxegH-n_-bo904hjZATvkl
E_2Yq6nxlQ\u0026utm_medium=product_shelf\u0026utm_source=youtube","target":"TARGET_NEW_WINDOW"}}]}},"accessibilityTitle":"Tapo C425 Kit MagCam 2K Solar Powered Security Camera, 142° Super-Wide FOV, Free AI Detection, Full-Color Night Vision, Two-Way Audio، د.م.‏ ‏930.51 ، من TP-Link Tapo","buttonAccessibilityText":"شراء سِلع من TP-Link Tapo","fromVendorText":"مِن TP-Link Tapo","additionalFeesText":"","showOpenInNewIcon":true}}],"trackingParams":"CN0BEJT0ARgDIhMIwYSF0MmJlgMVHvgRCB3dxg4a","showText":"انقر مرّتين لتوسيع الصفحة","hideText":"انقر مرّتين لتصغير الصفحة","actionButton":{"menuRenderer":{"items":[{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"لمحة عن المنتجات والعمولات"}},"simpleText":"لمحة عن المنتجات والعمولات"},"icon":{"iconType":"HELP"},"serviceEndpoint":{"clickTrackingParams":"CN0BEJT0ARgDIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","openPopupAction":{"popup":{"fancyDismissibleDialogRenderer":{"dialogMessage":{"runs":[{"text":"تستند المنتجات المدرَجة هنا إلى ما ورد في الفيديو قيد التشغيل أو في مجموعات التسوّق، أو إلى نشاطك السابق أثناء تسجيل الدخول إلى YouTube. ويشمل ذلك المنتجات التي بحثت عنها أو تلك المُشار إليها في الفيديوهات، أو المنتجات ذات الصلة. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"COABEMdVIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}},{"text":"\n\nيحدّد التجّار معلومات المنتجات والأسعار النهائية، وهي قابلة للتغيير. وقد يتمّ تحصيل رسوم إضافية منك متفاوتة القيمة، مثل رسوم الشحن والمناولة. يمكنك النقر على المنتجات أدناه أو الانتقال إلى متجر التاجر لإجراء عملية شراء والحصول على المزيد من المعلومات، بما في ذلك توفُّر المنتج والسعر النهائي الذي سيحصّله التاجر. تشمل الأسعار ضريبة القيمة المُضافة عند انطباقها.\n\nإنّ المنتجات المُشار إليها بأنّها \"عرض حصري للقناة\" تُعدّ بيانات منتجات قد شاركها تاجر حصريًا مع قناة محددة على YouTube. وتكون هذه المنتجات بسعر مخفَّض و/أو متوفرة لفترة محدودة وفقًا لأحكام التاجر وشروطه. يحدّد التاجر السعر النهائي وشروط الشراء ويكون مسؤولاً عنهما، بما في ذلك على سبيل المثال لا الحصر التحذيرات وعمليات سحب المنتجات من السوق وبيانات إخلاء المسؤولية ومعلومات الاستخدام. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"COABEMdVIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}},{"text":"\n\nلا يتحمّل YouTube أي مسؤولية عن منتجات التجّار أو معلومات المنتجات التي يقدمّونها. ولا يتحمّل YouTube كذلك أي مسؤولية عن أنشطتك وعمليات الشراء التي تُجريها لدى التجّار (بما في ذلك تلك التي تُجريها من خلال الروابط أدناه). تخضع هذه الأنشطة وعمليات الشراء للأحكام والشروط الخاصة بكل تاجر (بما في ذلك سياسة الخصوصية التي يتّبعها). قد يشارك YouTube المعلومات مع شركائنا لتنفيذ الخدمات وفقًا لسياسة الخصوصية لدينا وغيرها من تدابير الأمان والسرية اللازمة. على سبيل المثال، قد يشارك YouTube عنوان IP الخاص بك مع منصة التاجر لتسهيل المعاملة. تتوفّر مراجعات المنتجات في مواقع جغرافية معيّنة فقط، ولا تتحمّل Google مسؤولية إثبات صحة هذه المراجعات. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"COABEMdVIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}}]},"confirmLabel":{"simpleText":"حسنًا"},"trackingParams":"COABEMdVIhMIwYSF0MmJlgMVHvgRCB3dxg4a"}},"popupType":"DIALOG"}},"trackingParams":"CN0BEJT0ARgDIhMIwYSF0MmJlgMVHvgRCB3dxg4a"}},{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"الإبلاغ عن البيانات"}},"simpleText":"الإبلاغ عن البيانات"},"icon":{"iconType":"FLAG"},"serviceEndpoint":{"clickTrackingParams":"CN8BENbYBxgSIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://accounts.google.com/ServiceLogin?service=youtube\u0026uilel=3\u0026passive=true\u0026continue=https%3A%2F%2Fwww.youtube.com%2Fsignin%3Faction_handle_signin%3Dtrue%26app%3Ddesktop%26hl%3Dar\u0026hl=ar","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"signInEndpoint":{"nextEndpoint":{"clickTrackingParams":"CN8BENbYBxgSIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/flag/get_form"}},"getReportFormEndpoint":{"params":"_____"}}}},"trackingParams":"CN8BENbYBxgSIhMIwYSF0MmJlgMVHvgRCB3dxg4a","loggingDirectives":{"trackingParams":"CN8BENbYBxgSIhMIwYSF0MmJlgMVHvgRCB3dxg4a","visibility":{"types":"15"},"gestures":{"types":"4"}}}},{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"رفض"}},"simpleText":"رفض"},"icon":{"iconType":"HIDE"},"serviceEndpoint":{"clickTrackingParams":"CN4BEJeJFBgTIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpK27E5WGWtRFOCCpbSFPTy0owBca6QZGyQayK-JU9n9HYde8n77eroyonl45h7WF01qjX3ngOfDQakouvp8yDGPugAOBUG_mOx5zJcSjhFQ-lrGKefxPt0VvdBJ-mmu25iuellZdnG4zXQQHbIpM1uC3FNl36Dt74ttWBjv6crHr76WUBBf2YgSjBMnGgDbQuaZ6O6E","actions":[{"clickTrackingParams":"CN4BEJeJFBgTIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","hideEnclosingAction":{"hack":true}}]}},"trackingParams":"CN4BEJeJFBgTIhMIwYSF0MmJlgMVHvgRCB3dxg4a","loggingDirectives":{"trackingParams":"CN4BEJeJFBgTIhMIwYSF0MmJlgMVHvgRCB3dxg4a","visi
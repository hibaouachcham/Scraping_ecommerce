te":{"baseBackground":4293983231,"raisedBackground":4293983231,"additiveBackground":558212553,"textPrimary":4278855990,"textSecondary":4282015854,"invertedBackground":4279857039,"overlayBackground":3423217974},"darkThemeColorPalette":{"baseBackground":4278326556,"raisedBackground":4278855990,"additiveBackground":725984713,"textPrimary":4292932602,"textSecondary":4289515485,"invertedBackground":4286367459,"overlayBackground":3423217974},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBcQ040EGAciEwjBhIXQyYmWAxUe-BEIHd3GDhrKAQSzykKc","commandMetadata":{"webCommandMetadata":{"url":"/@TPLINKUS","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCbdQjm1J3gIJ2E_2Yq6nxlQ","canonicalBaseUrl":"/@TPLINKUS"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/Rc3Wo7oyKMTIYERUOiTR7cqFZk8wlXGqdYmH8xhcawhPECTqRUfpcAFErUZTgMLubTqwQZne3Q=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"Learn More about WiFi 6 by TP-Link: https://www.tp-link.com/us/wifi6/best...\n\nWhat is WiFi 6? (also known as AX WiFi)  \n \nWiFi 6 is the next generation standard in WiFi technology. WiFi 6 also known as “AX WiFi or 802.11 ax WiFi” builds and improves on the current 802.11ac WiFi standard. \nWiFi 6 was originally built in response to the growing number of devices in the world. If you own a VR device, multiple smart home devices, or simply have a large number of devices in your household, then a WiFi 6 router might just be the best WiFi router for you. \n\nAX WiFi uses both 1024 QAM to provide a signal packed with more data (giving you more efficiency) and a 160 MHz Channel to provide a wider channel to make your WiFi faster. Experience stutter-free VR or enjoy stunningly vivid 4K and even 8K streaming. \n\nWiFi 6 uses 8x8 uplink/downlink, MU-MIMO, OFDMA, and BSS Color to provide up to 4x larger capacity and to handle more devices. \n\nLearn more about WiFi 6 here: http://bit.ly/AXWIFIYT","commandRuns":[{"startIndex":36,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwjBhIXQyYmWAxUe-BEIHd3GDhpIvcbr2_adt4JtygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVHRDR2p0SXNQSjI0V21tRC1jcEIweXxBR3JiS2FuLWRlNlFMaElONlo4bE5rOUhIUUg1NG1PS0JidWFlMmtWbC1zNjRPWlJzX3RZelY5bWd0SkxENFF5a2JPUlB4Q2ZodGQ2WFhfQXlkbjVuTGdLakZpc05UWHhTY2JO\u0026q=https%3A%2F%2Fwww.tp-link.com%2Fus%2Fwifi6%2Fbest-wifi6-router%2F\u0026v=bQTc72t64z0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVHRDR2p0SXNQSjI0V21tRC1jcEIweXxBR3JiS2FuLWRlNlFMaElONlo4bE5rOUhIUUg1NG1PS0JidWFlMmtWbC1zNjRPWlJzX3RZelY5bWd0SkxENFF5a2JPUlB4Q2ZodGQ2WFhfQXlkbjVuTGdLakZpc05UWHhTY2JO\u0026q=https%3A%2F%2Fwww.tp-link.com%2Fus%2Fwifi6%2Fbest-wifi6-router%2F\u0026v=bQTc72t64z0","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":970,"length":22,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBcQ040EGAciEwjBhIXQyYmWAxUe-BEIHd3GDhpIvcbr2_adt4JtygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUTVMdzFYT3lfVEhRLTZmcGtzZHNuTnxBR3JiS2FsMGM1bU9CTTJ0QlNibGt1Ym9NV0pwWGVreWxwaTJGNGlKek1RZE1Db2x6OGFpX0NwTDluQzhSVzluUHZWLUwxMEI4UFlpTUhOR2l4RldzTWlON3pMUTh1RVVobmdl\u0026q=http%3A%2F%2Fbit.ly%2FAXWIFIYT\u0026v=bQTc72t64z0","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUTVMdzFYT3lfVEhRLTZmcGtzZHNuTnxBR3JiS2FsMGM1bU9CTTJ0QlNibGt1Ym9NV0p
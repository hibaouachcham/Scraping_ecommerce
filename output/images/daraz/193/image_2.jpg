dence and peace of mind.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcRhC9RZEBwpgyQXDjKadz-sak_BcCmOj25k2IkabjzBBwQ8lmg2YSaaAQ-ErRWFI5rjn1kfyqc","width":128,"height":128},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcQHD_6vwRb0gN7I-W2nc4KN2XS19cQb_fIOGmfUexg9zX13Zombs0dhB3KiPnLAF9C_E74kb6A","width":256,"height":256},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcQQZMZSzjdHXokWhkSg2LYAlOFbTvkxyLhr5jFq0JWWGU7GD1rVQBY-AFzoKLq2iNAiVvOWZcg","width":512,"height":512}],"placeholderColor":4294967295},"price":"د.م.‏ ‏1,116.63","vendorName":"TP-Link Tapo","trackingParams":"COoBEJP0ARgHIhMIwYSF0MmJlgMVHvgRCB3dxg4a","buttonText":"تسوّق","buttonCommand":{"clickTrackingParams":"COoBEJP0ARgHIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"COoBEJP0ARgHIhMIwYSF0MmJlgMVHvgRCB3dxg4aygEEs8pCnA==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpK-5EcyLF4BirMiLlMRb3hqnpLWistQ9Ed_8bfclcbdKK7atymj2Qp4ZczjpuX76PzHujygn2fvZVwOOmherrcvb2hX1P5qv8y6bAGibeXWMtO4ze5KpubjwuV-LgQjqC4_xuFP2ko8kEG3qQ1ArE1VOJp8eD6WLTtYV4s0iygnG7ooTNVQwfRh09jvucZ1vMvPd_iS3nGOw7URRKYje0ywwtToYkIxhCkb2PsOwCxzkRLjplGt706VCi1jkF8gKx2jabwFebMl_Bl04pOBA834PZJozJ30An-Hmh0gLhfk6mA8OoTsoILGaLyvH9lb-6MTp4yikKyxYGqfg3TSKNyVqmVOnGdjm4BDQs7jBdBsFH7WzokhhM4v_cD2ylzaXTGniESLlRkXkTX8_0WH-3tFQREap3MhDkoZIHbWuY5LnoDpuEV_e3AE1JsbZB6gepHKElgfxyprOKcVgE-oK7ZfbJ6h0Looyay-1vpxizWorBWk3dY9RHeX4tZQBtLb920CQ2X-eCOcKJpIhqO8s5jHDR8Gu5X297daDS9eN7ITqrBDDkwwm_PgpZ94Z2eA0R8oM6BZkOlzuQt_9WDLzva_mUsEQUGzYpyuyBJUew5ZfegazmcU9QCsyuj0MAQmpU3xz5dRz6jtxmut-AKAievYwpQmxl-SH1dR5ugZFc305bXmaKyT03RTl-lzWveWSSXmle3h40fxPv01aKPvZJjDUHsaA806rIK5E9zzmjRZ_QE6d0TW8sgbSycic9_SosIq5YxcjXVAWhKgBqOE178SyZcaRrVRlb7LpbOpogR2B0EmavOk1bj87V5GACvIsP206uGfT-a0NxM9YJ5rERwuzU9KsBPWzq15GjPoz6puP-oCXTE"}},{"clickTrackingParams":"COoBEJP0ARgHIhMIwYSF0MmJlgMVHvg
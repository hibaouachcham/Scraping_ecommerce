andMetadata":{"webCommandMetadata":{"url":"/@EuropeanCoffeeTrip","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UC3KGOt3IfrVxDNtz5o7H-5A","canonicalBaseUrl":"/@EuropeanCoffeeTrip"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_nM49iPvWnbfqU4I2dVG9bIDraDH6alsGYAIxrpwyOsXFY=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"Learn how to make coffee at home with the DeLonghi Dedica espresso machine. We will share how to make espresso, steam milk, and latte art for a cappuccino. We start with a simple routine using pre-ground coffee but then move to more advanced barista techniques to brew tasty coffee using specialty coffee beans.\n\n☕️ Say hello to Tomo on Instagram 👉   / specialtycoffeebarista  \n⭐ Find the best coffee shops in Europe 👉 https://europeancoffeetrip.com/mobile...\n📺  Watch our documentary about the AeroPress ► https://geni.us/AeropressMovie 👍\n\n-- FEATURED COFFEE TOOLS --\n(When available, we use affiliate links and may earn a commission!)\n\n► DeLonghi Dedica EC685: https://geni.us/qbFqa (Amazon)\n► Comandante C40 Grinder: https://geni.us/IzU3 (Amazon/Prima)\n► Acaia Scale: https://geni.us/Bet04 (Amazon/Prima)\n► Loveramics cups: https://www.loveramics.com/pages/coffee\n► Specialty coffee beans: https://www.beberrycoffee.cz\n\n🛠 All coffee gear \u0026 tools we use in our office: https://kit.co/europeancoffeetrip\n\n** OUR SPONSORS **\n► Victoria Arduino - http://www.victoriaarduino.com\n► AeroPress, Inc. - https://aeropress.com\n► Comandante - http://www.comandantegrinder.com\n► Cropster - https://www.cropster.com\n► Puqpress - https://www.puqpress.com\n► Hard Beans - https://hardbeans.com \n\n** STAY IN TOUCH **\n► https://www.europeancoffeetrip.com\n►   / europeancoffeetrip  \n►   / europeancoffeetrip  \n►   / eurocoffeetrip  \n\nTimestamps:\n0:00 Better Coffee on Cheap Home Espresso Machine\n0:25 DeLonghi Dedica EC685 Overview\n1:30 Espresso workflow with pre-ground coffee\n2:02 Espresso workflow with specialty coffee\n7:38 How to steam milk on DeLonghi Dedica\n10:26 Better espresso with bottomless portafilter\n12:30 Better latte art and milk steaming\n14:26 Final thoughts on DeLonghi Dedica EC685","commandRuns":[{"startIndex":350,"length":28,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwi73MCWyImWAxXTb3oFHdwzIG5I3deE0ZiwjO6JAcoBBFd_cyk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVFVCSGhlbHA1R280WDRtUzBYRXZBbHxBR3JiS2FrTVdJeUJ5RzBrcFZfUE8ybG5GZ0dLSy1yOFF1WXRYUzVlLTd1Vi1iU0trSUpkTlZmWkJpcUh3bXpHLXZWR1FTYVA3ZTVpQ1pxbHBJWUhpbjdDQ1c1VnNFV0MxNjVp\u0026q=https%3A%2F%2Fwww.instagram.com%2Fspecialtycoffeebarista%2F\u0026v=idwxgYohK90","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rVFVCSGhlbHA1R280WDRtUzBYRXZBbHxBR3JiS2FrTVdJeUJ5RzBrcFZfUE8ybG5GZ0dLSy1yOFF1WXRYUzVlLTd1Vi1iU0trSUpkTlZmWkJpcUh3bXpHLXZWR1FTYVA3ZTVpQ1pxbHBJWUhpbjdDQ1c1VnNFV0MxNjVp\u0026q=https%3A%2F%2Fwww.instagram.com%2Fspecialtycoffeebarista%2F\u0026v=idwxgYohK90","target":"TARGET_NEW_WINDOW","nofollow":true}}},"onTapOptions":{"accessibilityInfo":{"accessibilityLabel":"Instagram Channel Link: specialtycoffeebarista"}}},{"startIndex":421,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwi73MCWyImWAxXTb3oFHdwzIG5I3deE0ZiwjO6JAcoBBFd_cyk=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUjVZVUV6SkJDR0VzMmNGUkZmWW54THxBR3JiS2FtOWd6ZUpqZFlIOE5QQXFaOTFJOEpqM3lpbDRpcGhlV21HalFScjgybFU1Qk5kRkVzeFVjRDNDZ3NsWS0xS3hxYVZpMkNEaHU4Tnpn
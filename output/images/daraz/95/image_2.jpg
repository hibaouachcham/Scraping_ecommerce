}},{"factoidRenderer":{"value":{"simpleText":"2020"},"label":{"simpleText":"28 يوليو"},"accessibilityText":"28‏/07‏/2020","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4293983743,"raisedBackground":4293983743,"additiveBackground":558217162,"textPrimary":4278596410,"textSecondary":4280318600,"invertedBackground":4279794570,"overlayBackground":3422958394},"darkThemeColorPalette":{"baseBackground":4278262045,"raisedBackground":4278596410,"additiveBackground":725989322,"textPrimary":4292802812,"textSecondary":4288537068,"invertedBackground":4286436835,"overlayBackground":3422958394},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CCEQ040EGAciEwiOxq7C2N6VAxW_CVUIHRkVKiTKAQSufnr6","commandMetadata":{"webCommandMetadata":{"url":"/@SketchyOnReviews","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCgs-7Wb0ZU38CG9f0Qu54rw","canonicalBaseUrl":"/@SketchyOnReviews"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_mlsq_4yMT7eBF2VTUGJkqDFXPp95jZATobr9VNHTj61jY=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"رابط المنتج:\nموديل C200: https://shope.ee/2q5dkEGIWY\nموديل C220: https://shope.ee/AKBiOHfxJo\n\n➤ فيديو عالي الوضوح: يسجل كل صورة بدقة 1080p فائقة الوضوح\n➤ تحريك الكاميرا أفقيًا وعموديًا: نطاق 360 درجة أفقيًا و114 درجة رأسيًا\n➤ رؤية ليلية متطورة: توفر مدى رؤية يصل إلى 9 أمتار\n➤ كشف الحركة والإشعارات: يُعلمك عند رصد الكاميرا أي حركة\n➤ إنذار صوتي وضوئي: يُشغل مؤثرات صوتية وضوئية لإبعاد المتطفلين\n\n➤ صوت ثنائي الاتجاه: يُمكّنك من التواصل عبر ميكروفون ومكبر صوت مدمجين\n➤ تخزين آمن: يخزن محليًا حتى 128 جيجابايت على بطاقة microSD، أي ما يعادل 384 ساعة (16 يومًا) من التسجيلات. (بناءً على ظروف المختبر)\n\n➤ التحكم الصوتي: حرر يديك مع التحكم الصوتي: يعمل مع مساعد جوجل وأمازون أليكسا. (مساعد جوجل وأمازون أليكسا غير متوفرين بجميع اللغات وفي جميع البلدان)\n\n________________________________________________________________________\n\nمعدات الاستوديو:\nالكاميرا:\nسوني A6400: https://shope.ee/4pqehBCl1d\nسوني ZV-1: https://shope.ee/4KuO6JHqgT\nبطارية وهمية لسوني ZV-1: https://shope.ee/5Kmxxk2ec2\nكاميرا ويب لوجيتك بريو: https://shope.ee/LOFRh9Pv7\n\nالعدسات:\nسيجما 16 مم F1.4: https://shope.ee/7KXzfuZCqt\nسيجما 30 مم F1.4: https://shope.ee/7fAq4ZjzeS\nسيجما 56 مم F1.4: https://shope.ee/8f3NGSs6Zh\n\nملحقات الكاميرا:\nكاميرا Falcam: https://shope.ee/4KuRSwk3EX\nمثبت Peak Design: https://shope.ee/7znjpq1iue\nقفص SmallRig A6400: https://shope.ee/lSLflswe\nكابل محول HDMI عالمي من SmallRig: https://shope.ee/5pjFHpHolF\nمقبض علوي من SmallRig لكاميرا DSLR/Corder المحمولة باليد 1638: https://shope.ee/2ApwvMOqB7\nجهاز GoLive Mini Teleprompter TP-1 للتلقين التلقائي للهواتف المحمولة والكاميرات\n5.0: https://shope.ee/7fAtTxVWF7\nمحول طاقة وهمي: https://shope.ee/2VSnKaLYfp\nبطاقة التقاط HDMI: https://shope.ee/5Kmyhyx3Z2\nمقبض خشبي على شكل حرف L من SmallRig 2936 مع قاعدة تثبيت لكاميرا Sony ZV1\n\nhttps://shope.ee/7pUJh2oxH6\n\nمعدات الصوت:\nRode NTG: https://shope.ee/AUV1YxrZjH\nRode Wireless Go II / Wireless Go 2: https://shope.ee/3py7Vjp4aX\nShure SM7B: https://shope.ee/B4pF1awQJ\nChanterMic: https://shope.ee/10dzYeAvh3\n\nمعدات الإضاءة:\nصندوق إضاءة LED ناعم من Godox 260C: https://shope.ee/1AxMKvsGQa\n\nمعدات أخرى:\nكرسي (TT Racing Duo V3): https://shope.ee/8A76fqQP5U\n\n________________________________________________________________________\nرابط المنتج:\nموديل C200: https://shope.ee/2q5dkEGIWY\nموديل C220: https://shope.ee/AKBiOHfxJo\n\n#TAPO #C200","commandRuns":[{"startIndex":25,"length":27,"onTap":{"innertubeCommand":{"clickTrackingParams":"CCEQ040EGAciEwiOxq7C2N6VAxW_CVUIHRkVKiRIupDKifzh_-jCAcoBBK5-evo=","command
EI9fAgbaRyVqfojTHE57Vpq_Goif3569GLm5fsmxqsH3ulcu7Hnt495gxqCWw9RosiCpVaJWoMgfbSPA8kL0\u0026utm_term=UC9VhfQi-D-7morDdwjVcJPA\u0026utm_medium=product_shelf\u0026utm_source=youtube","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.seattlecoffeegear.com/products/gimme-coffee-stargazer-fairtrade-organic?variant=49384315650355\u0026srsltid=AfmBOooAgjTlPpM_FBY1hoynbmqbM_m9nFDrXBE_UQX3WQTp-eaL8AQY1ls\u0026utm_content=YT3-ltxSxUoATLsKX1dZ9dDEI9fAgbaRyVqfojTHE57Vpq_Goif3569GLm5fsmxqsH3ulcu7Hnt495gxqCWw9RosiCpVaJWoMgfbSPA8kL0\u0026utm_term=UC9VhfQi-D-7morDdwjVcJPA\u0026utm_medium=product_shelf\u0026utm_source=youtube","target":"TARGET_NEW_WINDOW"}}]}},"accessibilityTitle":"Gimme! Coffee Stargazer Medium Roast Coffee, Fairtrade, Organic, 12 oz, Almond And Chocolate Notes, Sweet Raspberry Finish, Specialty Arabica Beans، مناطق الشحن محدودة ، من Seattle Coffee Gear","buttonAccessibilityText":"شراء سِلع من Seattle Coffee Gear","fromVendorText":"مِن Seattle Coffee Gear","additionalFeesText":"","showOpenInNewIcon":true,"priceReplacementText":"مناطق الشحن محدودة"}}],"trackingParams":"CPABEJT0ARgDIhMInMOaociJlgMVsmt6BR2qVB-E","showText":"انقر مرّتين لتوسيع الصفحة","hideText":"انقر مرّتين لتصغير الصفحة","actionButton":{"menuRenderer":{"items":[{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"لمحة عن المنتجات والعمولات"}},"simpleText":"لمحة عن المنتجات والعمولات"},"icon":{"iconType":"HELP"},"serviceEndpoint":{"clickTrackingParams":"CPABEJT0ARgDIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","openPopupAction":{"popup":{"fancyDismissibleDialogRenderer":{"dialogMessage":{"runs":[{"text":"تستند المنتجات المدرَجة هنا إلى ما ورد في الفيديو قيد التشغيل أو في مجموعات التسوّق، أو إلى نشاطك السابق أثناء تسجيل الدخول إلى YouTube. ويشمل ذلك المنتجات التي بحثت عنها أو تلك المُشار إليها في الفيديوهات، أو المنتجات ذات الصلة. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"CPMBEMdVIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}},{"text":"\n\nيحدّد التجّار معلومات المنتجات والأسعار النهائية، وهي قابلة للتغيير. وقد يتمّ تحصيل رسوم إضافية منك متفاوتة القيمة، مثل رسوم الشحن والمناولة. يمكنك النقر على المنتجات أدناه أو الانتقال إلى متجر التاجر لإجراء عملية شراء والحصول على المزيد من المعلومات، بما في ذلك توفُّر المنتج والسعر النهائي الذي سيحصّله التاجر. تشمل الأسعار ضريبة القيمة المُضافة عند انطباقها.\n\nإنّ المنتجات المُشار إليها بأنّها \"عرض حصري للقناة\" تُعدّ بيانات منتجات قد شاركها تاجر حصريًا مع قناة محددة على YouTube. وتكون هذه المنتجات بسعر مخفَّض و/أو متوفرة لفترة محدودة وفقًا لأحكام التاجر وشروطه. يحدّد التاجر السعر النهائي وشروط الشراء ويكون مسؤولاً عنهما، بما في ذلك على سبيل المثال لا الحصر التحذيرات وعمليات سحب المنتجات من السوق وبيانات إخلاء المسؤولية ومعلومات الاستخدام. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"CPMBEMdVIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/youtube/answer/12257682?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}},{"text":"\n\nلا يتحمّل YouTube أي مسؤولية عن منتجات التجّار أو معلومات المنتجات التي يقدمّونها. ولا يتحمّل YouTube كذلك أي مسؤولية عن أنشطتك وعمليات الشراء التي تُجريها لدى التجّار (بما في ذلك تلك التي تُجريها من خلال الروابط أدناه). تخضع هذه الأنشطة وعمليات الشراء للأحكام والشروط الخاصة بكل تاجر (بما في ذلك سياسة الخصوصية التي يتّبعها). قد يشارك YouTube المعلومات مع شركائنا لتنفيذ الخدمات وفقًا لسياسة الخصوصية لدينا وغيرها من تدابير الأمان والسرية اللازمة. على سبيل المثال، قد يشارك YouTube عنوان IP الخاص بك مع منصة التاجر لتسهيل المعاملة. تتوفّر مراجعات المنتجات في مواقع جغرافية معيّنة فقط، ولا تتحمّل Google مسؤولية إثبات صحة هذه المراجعات. ","textColor":4279440147},{"text":"مزيد من المعلومات","navigationEndpoint":{"clickTrackingParams":"CPMBEMdVIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://support.google.com/googleshopping/answer/9370999?nohelpkit=1","target":"TARGET_NEW_WINDOW"}}}]},"confirmLabel":{"simpleText":"حسنًا"},"trackingParams":"CPMBEMdVIhMInMOaociJlgMVsmt6BR2qVB-E"}},"popupType":"DIALOG"}},"trackingParams":"CPABEJT0ARgDIhMInMOaociJlgMVsmt6BR2qVB-E"}},{"menuServiceItemRenderer":{"text":{"accessibility":{"accessibilityData":{"label":"الإبلاغ عن البيانات"}},"simpleText":"الإبلاغ عن البيانات"},"icon":{"iconType":"FLAG"},"serviceEndpoint":{"clickTrackingParams":"CPIBENbYBxgfIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"url":"https://accounts.google.com/ServiceLogin?service=youtube\u0026uilel=3\u0026passive=true\u0026continue=https%3A%2F%2Fwww.youtube.com%2Fsignin%3Faction_handle_signin%3Dtrue%26app%3Ddesktop%26hl%3Dar\u0026hl=ar","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"signInEndpoint":{"nextEndpoint":{"clickTrackingParams":"CPIBENbYBxgfIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/flag/get_form"}},"getReportFormEndpoint":{"params":"-__--UGhpbGlwcyBTYWVjbyA1NTAwIExhdHRlR28gU3VwZXJhdXRvbWF0aWMgRXNwcmVzc28gTWFjaGluZSwgU3RhaW5sZXNzIFN0ZWVsLCBQbGFzdGljIEFsdW1pbnVtLCA5LjUgSW5jaGVzLCBTZWF0dGxlIENvZmZlZSBHZWFyCgMKASwKAwoBIAoZChfYry7ZhS7igI___-IFNob3AgCgMKASwKAwoBIAoWChTYry7ZhS7igI___-__"}}}},"trackingParams":"CPIBENbYBxgfIhMInMOaociJlgMVsmt6BR2qVB-E","loggingDirectives":{"trackingParams":"CPIBENbYBxgfIhMInMOaoc
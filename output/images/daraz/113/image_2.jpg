Clearyl Smart+ balances long runtime with consistent filtration efficiency, installs tool-free for immediate operation, and hands control to your machine so brewing settings and service reminders stay in sync. Ideal for households and dedicated coffee lovers who value build quality, repeatable extraction, and effortless upkeep, this filter helps ensure each cup reflects the care you put into sourcing and dialing in beans without adding complexity to your routine.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcT9qwIj0auN6-47MyObyD-Et6QRIpRPeQjxWvpUSd7hXC2hBGTaFISNlac6Sln-uF1ojJdazNs","width":128,"height":128},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcTrdLIlhcRdPLf4bqgxalnRq4r8pVKKjLj5srV_700qofOZXO7VLCHv86nLvLJXSbl322aFS8c","width":256,"height":256},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcR-B8iUBOq1h2lvtJjMlzlUPku0TxZ5znmHbiKS4rgkbIAes5YuifvpCgjUAh0CCtjGjvPKqOmbsQ","width":512,"height":512}],"placeholderColor":4294967295},"price":"د.م.‏ ‏232.66","vendorName":"Seattle Coffee Gear","trackingParams":"CPwBEJP0ARgVIhMInMOaociJlgMVsmt6BR2qVB-E","buttonText":"تسوّق","buttonCommand":{"clickTrackingParams":"CPwBEJP0ARgVIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CPwBEJP0ARgVIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpLSERD9skgSsFszRtpZgt2eK4K_M65kX9sSBSHKt-bD8GI7yrsjBT4iLLn0n70B3URy41MAAEfxyhIYiYYMTgJ2HVYpzdWOPqwWRxAT8cUVxOec3uvqIBoIqnlfCQIG-fakEdjl4qTYgYeHPBbHAsA_VGukGdBZ1_smPHIa-R6EJSEwh3JgsmccAc-apwq4eIo02S6DvXAXncXX-9u8yJ86Dmr0X_K9GoFUIoPpUueLKBwXwgmOBBFgddE77XkBinwx5Q12fmRKmWlW5mBqlxdcu1i-ke-AuD2DaTFdCNJ5ACkNeDGcPB-dcWNgK1BgsUA_aKaaRSgdHOY_kgRYZcaB_l4lCClCGBo3laUzUjdVvPE7KuL6bXtf_PQqJtXJ_RwRdY2IJfS-C8uCdE3cJBXyyPaMTUWUVN_DwdkcyHKiyovTNI867oCUQ2HUIKGiC7qanoiy3XJOilr0wO5KMsP7SxDY_LpFx2BnrT40CNW
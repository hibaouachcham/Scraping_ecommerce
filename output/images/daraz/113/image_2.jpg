r a meticulous setup.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcQLZVppiBLK5tUxqFJVqnhXYmPrIUrLEq8fHTFkySZB98fBJPxF9r8NocyH7D8uzBrAwtgG8mA-","width":128,"height":128},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcQcjy1oZfxcNPuHuDBpusn0Lgj2axKDDG47MOZZkr7DP0ccooZngDEd8D8ixMpKC4ULoczJpFyD","width":256,"height":256},{"url":"https://encrypted-tbn3.gstatic.com/shopping?q=tbn:ANd9GcT10E1zw7tvUtN0Rt4FIa0CPpdXzvW498u--v22V8Kf97q41wpdq4q8r5OgYQ-WLQcG0ue1K3_rQVU","width":479,"height":479}],"placeholderColor":4294967295},"price":"د.م.‏ ‏1,023.20","vendorName":"Seattle Coffee Gear","trackingParams":"CIwCEJP0ARgFIhMInMOaociJlgMVsmt6BR2qVB-E","buttonText":"تسوّق","buttonCommand":{"clickTrackingParams":"CIwCEJP0ARgFIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CIwCEJP0ARgFIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpJDzIm6_KT77639cBtXjLAPvYKibejLDGi5NO6F-enOiZGNS9kCjl0yro4DjKQDXhE31naTyx2Zyhu6DaXfDkVrSMMooUmbS11oA52dlqDYCBjTqF0zTG0y55u3jT4dNxb0WM8GjNCqUOFMfjFcBE8vfwuhhLlEZYjvwuHfInEjrBxmp1vNJlfR-Sp2_jk8txkEdhucdYrCdpPmTEBCdGSzy42J_4cseFA-odIezNv2twU8YYD0Y04dp7yeCH-7Uq9-dyU8PGBPP3WDE-N_efAyengMMJP802XcK4aL_ZPvfTKF_VNQkrrT0rHfsWr_jqS19r681wyGGx7i_64ErJtJ2Yzuu-AE64nhK8GejUqyRMYKU1UJNZyCuJ8wD9RXuu6LsBXuZwJ3B6hOAWfwMeLukOqN3guEuJjHK10eNHVCUJrEfbrX0_oPDVknEem89uLA9de4QP9mcim-HapPlW_obVBJml28MvlujAkyIXooNu3YGM4xcb0zWrxlYTcTlvABN6oDAo80zh6Yz8-Klb7kdIsHiF-azT3QhyaihXFMJy1yar2nS60kAvZdDVeBKKmeJLcE67xqzPyY2lyRrk16GaGjXYlcBdDKD3Sani1uAq9I2u7aDQvMn4RRG1vqZxOYkv9EKmNhrNmGb9ijJTg92kWJyS7GL5ddLj9kBu5eFN_zphfXXJESCXAdS4do-wma5qr9sfMWWZfx6fmib18b1tIwgrE1HjfJdXWJXeBRLiqvIsQ"}},{"clickTrackingParams":"CIwCEJP0ARgFIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"url":"https://www.seattlecoffeegear.com/products/breville-distributor-duo?variant=50798680670515\u0026srsltid=AfmBOorTpTqw2VdxoLY-gdI2KomxOKMB4XsNFwt3RRTXZyZkGoc8OnD0sCs\u0026utm_content=YT3-227bx99guvzTSmambjY-eOapfTJX4JveZvcoq_om-0290Daw1TYqypPKx74hCgGuiv4aUJ0xYmHVdqNBJuxldBedm799NJ0xPzZHlBo\u0026utm_term=UC9VhfQi-D-7morDdwjVcJPA\u0026utm_medium=product_shelf\u0026utm_source=youtube","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.seattlecoffeegear.com/products/breville-distributor-duo?variant=50798680670515\u0026srsltid=AfmBOorTpTqw2VdxoLY-gdI2KomxOKMB4XsNFwt3RRTXZyZkGoc8OnD0sCs\u0026utm_content=YT3-227bx99guvzTSmambjY-eOapfTJX4JveZvcoq_om-0290Daw1TYqypPKx74hCgGuiv4aUJ0xYmHVdqNBJuxldBedm799NJ0xPzZHlBo\u0026utm_term=UC9VhfQi-D-7morDdwjVcJPA\u0026utm_medium=product_shelf\u0026utm_source=youtube","target":"TARGET_NEW_WINDOW"}}]}},"accessibilityTitle":"Breville Distributor Duo Espresso Distributor, 54mm, Steel And Walnut, Seattle Coffee Gear، مناطق الشحن محدودة ، من Seattle Coffee Gear","buttonAccessibilityText":"شراء سِلع من Seattle Coffee Gear","fromVendorText":"مِن Seattle Coffee Gear","additionalFeesText":"","showOpenInNewIcon":true,"priceReplacementText":"مناطق الشحن محدودة"}},{"merchandiseItemRenderer":{"title":"Breville Espresso Machine, Dual Stainless Steel Boilers, PID Control, Programmable Pre-Infusion, Semi-Automatic, Brushed Stainless Steel, 16.25 inches","description":"The Breville Dual Boiler in brushed stainless steel is a precision-built, semi-automatic machine that brings commercial-level craftsmanship and café-grade brewing to both dedicated home baristas and coffee lovers who want more consistency and control. Robust stainless-steel construction, a heated group head and full-size 58mm portafilter deliver stable thermal performance and even extraction, while independent dual boilers and dual PID controllers maintain exact temperatures for simultaneous brewing and steaming so you don’t sacrifice shot quality for milk texturing. Programmable pre-infusion, adjustable pre-infusion pressure, volumetric shot control and a clear pressure gauge let you dial in recipes from ristretto to lungo with repeatable accuracy, and the commercial-style steam wand yields microfoam suited to latte art or everyday lattes. Thoughtful touches—an accessible 84 oz swivel water reservoir, front and rear access, auto-on timer and intuitive shot clock—keep operation straightforward for daily routines without compromising the technical features advanced users expect. Whether you’re elevating morning espresso rituals or honing technique with precise temperature and pressure control, this machine balances serious performance with approachable ease of use for anyone who genuinely cares about great coffee.","thumbnail":{"thumbnails":[{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcT1JpOA4ZunqTO7pUDJRZBakFxYxqiS6xP6dqvS2EW29Xssd5rsPRuwCDEGpm7suJkKW6XH8Lc","width":128,"height":128},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcTzkTsDAIugbFwZpy3WB_SSdjcwc1whbwZeiFX11ftSQ-n7Z9BoCSYdBi667v63PUT90FtpbEU","width":256,"height":256},{"url":"https://encrypted-tbn1.gstatic.com/shopping?q=tbn:ANd9GcQC_cAiQW2E5mo_zoJX5MOWHsrtclMhIk-ecAh2eKNBh1N4FCVHUsZZAM5aA9TTI7_4ueixnq4","width":512,"height":512}],"placeholderColor":4294967295},"price":"د.م.‏ ‏14,889.17","vendorName":"Seattle Coffee Gear","trackingParams":"CIsCEJP0ARgGIhMInMOaociJlgMVsmt6BR2qVB-E","buttonText":"تسوّق","buttonCommand":{"clickTrackingParams":"CIsCEJP0ARgGIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandExecutorCommand":{"commands":[{"clickTrackingParams":"CIsCEJP0ARgGIhMInMOaociJlgMVsmt6BR2qVB-EygEEDPS-XQ==","commandMetadata":{"webCommandMetadata":{"sendPost":true,"apiUrl":"/youtubei/v1/feedback"}},"feedbackEndpoint":{"feedbackToken":"AB9zfpJBC3MPi7srAzvWGMHla7ro_sd6IyNCZEK8J1xUxQ4Q3me3DvZDDK9suhZmgWSJflhDabGuOQeY-SX02DVTi8K-tz141f-jhZdBZPhj3iYKmsJPdKP6J-AP3Rz0auU7bVGaIbAqG0SUQy4Q4fwmmQ13KyQvAhEMSS2uNez2pJOTqD9ugQSW0P9Fwd7yhFmBCELqsxJDHS8m1z8H2cxv9uGLvwMzJsmH51Scqlfy
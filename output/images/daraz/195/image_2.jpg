ackground":3424657440},"enableColorSampledText":true}},{"viewCountFactoidRenderer":{"viewCountEntityKey":"EgtNejdxZ3FhNWYyOCDCASgB","factoid":{"factoidRenderer":{"value":{"simpleText":"72,330"},"label":{"simpleText":"عدد المشاهدات"},"accessibilityText":"72,330 مشاهدة","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"enableColorSampledText":true}},"viewCountType":"VIEW_COUNT_FACTOID_TYPE_TOTAL_VIEWS"}},{"factoidRenderer":{"value":{"simpleText":"2021"},"label":{"simpleText":"30 أكتوبر"},"accessibilityText":"30‏/10‏/2021","backgroundColorStyle":"BACKGROUND_COLOR_STYLE_COLOR_SAMPLED","lightThemeColorPalette":{"baseBackground":4294440951,"raisedBackground":4294440951,"additiveBackground":562530183,"textPrimary":4280295456,"textSecondary":4283716692,"invertedBackground":4283716692,"overlayBackground":3424657440},"darkThemeColorPalette":{"baseBackground":4279176975,"raisedBackground":4280295456,"additiveBackground":730302343,"textPrimary":4293783021,"textSecondary":4291085508,"invertedBackground":4289111718,"overlayBackground":3424657440},"position":"FACTOID_POSITION_LAST","enableColorSampledText":true}}],"channelNavigationEndpoint":{"clickTrackingParams":"CBUQ040EGAciEwixhtnSyYmWAxWnyk8IHSRaMafKAQTtT2pD","commandMetadata":{"webCommandMetadata":{"url":"/@landpet","webPageType":"WEB_PAGE_TYPE_CHANNEL","rootVe":3611,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"UCXvw3vS-KzCHU7RVSJc0R9A","canonicalBaseUrl":"/@landpet"}},"channelThumbnail":{"thumbnails":[{"url":"https://yt3.ggpht.com/ytc/AIdro_keAZW4mNNSKddNIXNR1pTllOmkK2-YG_91SDOYepl9Bw=s88-c-k-c0x00ffffff-no-rj"}]}}},{"expandableVideoDescriptionBodyRenderer":{"showMoreText":{"accessibility":{"accessibilityData":{"label":"عرض المزيد"}},"simpleText":"...المزيد"},"showLessText":{"simpleText":"عرض محتوى أقل"},"attributedDescriptionBodyText":{"content":"مراجعة جهاز TP-Link Archer AX73 AX5400. يُعدّ جهاز التوجيه TP-Link Archer AX73 AX5400 ثنائي النطاق المزود بتقنية Wi-Fi 6 خيارًا ممتازًا. فتح العلبة، وإجراء اختبارات سرعة الإنترنت عبر speedtest.net، واختبار السرعة على خادم محلي، واختبارات النطاق الكامل باستخدام جهاز يدعم WiFi 6 وWiFi 5. اطّلع على تطبيق TP-Link Tether، وواجهة الويب، وغير ذلك الكثير. ما هو أفضل جهاز توجيه لعام 2021؟ ✔️اشترك: https://www.youtube.com/c/landpet?sub...\n\nروابط المنتجات\n--------------------------------------\nTP-Link Archer AX73 AX5400: https://amzn.to/3vW8OM1\nTP-Link Archer AX21 AX1800: https://amzn.to/3k4dGu0\n\nروابط الفيديو\n---------------------------------------\nأساسيات الشبكات: شرح الشبكات المنزلية:    • Network 101 | Simplified explanation of a ...  \nكيفية اختيار جهاز توجيه أو شبكة Wi-Fi شبكية:    • How to pick a Router or Mesh Wi-Fi  \n\nمقارنة بين TP-Link Archer AX21 وSpeedefy KX450:    • Speedefy KX450 vs TP-Link Archer AX21 Revi...  \n\nمراجعة TP-Link Deco X20:    • TP Link Deco X20 Unboxing and Review | TP ...  \nمراجعة جهاز TP-Link Deco X60:    • TP-Link Deco X60 Unboxing and Review | Con...  \nمراجعة جهاز TP-Link Deco X68:    • TP-Link Deco X68 Unboxing and Review | Bes...  \nمراجعة جهاز TP-Link Deco X90:    • TP Link Deco X90 Unboxing and Review | Mes...  \nمقارنة بين جهاز TP-Link Deco X60 وX90:    • TP Link Deco X60 vs Deco X90 | Dual Band v...  \n\nمراجعة جهاز ASUS XT8:    • ASUS ZenWiFi AX XT8 Unboxing and Review  \nمراجعة جهاز eero Pro 6:    • eero Pro 6 Review | Unbox, Mesh Wifi Optio...  \nمراجعة جهاز Netgear Orbi RBK752:    • Netgear Orbi Unbox and Review | Watch Befo...  \n\nمراجعة جهاز Nest Wifi:    • Nest WiFi Router | Long Term Review | All ...  \n\nمراجعة جهاز eero 6:    • eero 6 Review | Unbox, Mesh Wifi Options a...  \nمراجعة eero Pro 6 مقابل eero 6:    • eero 6 VS eero Pro 6 Review | Watch Before...  \neero Pro 6 مقابل Netgear Orbi:    • Eero Pro 6 vs Netgear Orbi Review | Specs,...  \nمراجعة eero Pro 6 مقابل Nest Wifi:    • eero Pro 6 vs Nest Wifi Review and the Win...  \n\nفيديو إعداد Nest Wifi:    • Google Nest WiFi | FAQs Answered | All Con...  \nفيديو إعداد eero Pro 6:    • eero Pro 6 Setup Guide | FAQ's Answered | ...  \nفيديو إعداد eero 6:    • eero 6 Setup Guide | FAQ's Answered | All ...  \n\nمراجعة مُبدِّل شبكة جيجابت:    • TP-Link 24 Port Gigabit Ethernet Switch Un...  \n\nالجدول الزمني\n---------------------------------------\n00:00:00 - مراجعة TP Link AX73\n00:00:51 - فتح علبة راوتر TP-Link Archer AX73\n00:03:15 - اختبار سرعة الإنترنت TP-Link AX73\n00:04:00 - اختبار السرعة المحلية TP-Link AX73\n00:04:42 - اختبار مدى TP-Link AX73\n00:05:55 - ميزات TP-Link AX73","commandRuns":[{"startIndex":392,"length":40,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwixhtnSyYmWAxWnyk8IHSRaMafKAQTtT2pD","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/c/landpet?sub_confirmation=1","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/c/landpet?sub_confirmation=1","nofollow":true}}}},{"startIndex":516,"length":23,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBUQ040EGAciEwixhtnSyYmWAxWnyk8IHSRaMadI7_7ltarQup8zygEE7U9qQw==","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM4Zm9rUmlGaU15M2J1WmNERlZjVnp4QU1CNnxBR3JiS2FtRk9NcnR0RXJFa05ocC1WZFhTVkdnRF9oSXVwcTJmWjJPMWMwZHc1THU5Z1JpRlFfVjBmdnA0MUNrRGVZLTJQLWlsRWl6bzlXSldZbnZkWjQyemtUTjNtVFN3Wld3\u0026q=https%3A%2F%2Famzn.to%2F3vW8OM1\u0026v=Mz7qgqa5f28","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\u0026redir_token=QUM